<UserControl x:Class="EnglishTraining.Views.PopupContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:EnglishTraining.Converters"
             MaxWidth="320">
    <UserControl.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
    </UserControl.Resources>
    <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
        </Border.Effect>
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" TextWrapping="Wrap" />

            <StackPanel Visibility="{Binding Interpretation, Converter={StaticResource NullToVisibility}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding InterpretationHeader}" TextWrapping="Wrap" />
                <Border BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Margin="0,4,0,4"
                        Visibility="{Binding Interpretation.Expression, Converter={StaticResource NullToVisibility}}" />
                <TextBlock Text="{Binding Interpretation.Expression}" TextWrapping="Wrap" FontStyle="Italic"
                           Visibility="{Binding Interpretation.Expression, Converter={StaticResource NullToVisibility}}" />
            </StackPanel>

            <StackPanel Visibility="{Binding Writing, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="Writing" FontWeight="SemiBold" Foreground="#2563EB" />
                <TextBlock Text="{Binding Writing.Description}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Writing.Example}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,4,0,0" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
