<Window x:Class="EnglishTraining.Views.InterpretationManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Word Management" Height="520" Width="840"
        Icon="pack://application:,,,/Assets/english-training.png"
        AllowDrop="True"
        PreviewDragEnter="OnPreviewDragOver"
        PreviewDragOver="OnPreviewDragOver"
        PreviewDrop="OnPreviewFileDrop">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Open" Click="OnFileOpenClick" />
                <MenuItem Header="Save" Click="OnFileSaveClick" />
                <MenuItem Header="Save As" Click="OnFileSaveAsClick" />
            </MenuItem>
            <MenuItem Header="Word">
                <MenuItem Header="New" Click="OnAddNewClick" />
                <MenuItem Header="Import" Click="OnImportClick" />
                <MenuItem Header="Export" Click="OnExportClick" />
                <MenuItem Header="Delete" Click="OnDeleteClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="New" Padding="8,4" Margin="0,0,8,0" Click="OnAddNewClick" />
                <Button Content="Import" Padding="8,4" Margin="0,0,8,0" Click="OnImportClick" />
                <Button Content="Delete" Padding="8,4" Click="OnDeleteClick" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding FileStatusText}" Foreground="#666666" FontSize="11" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <Button Content="Ascending" Padding="8,4" Margin="0,0,4,0" Click="OnSortAscendingClick" />
                    <Button Content="Descending" Padding="8,4" Click="OnSortDescendingClick" />
                </StackPanel>
                <ListBox x:Name="EntriesListBox"
                         ItemsSource="{Binding Entries}"
                         DisplayMemberPath="Text"
                         SelectionMode="Extended"
                         SelectedItem="{Binding SelectedEntry}" />
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <StackPanel Grid.Column="2" Margin="12">
                <TextBlock Text="Word/Idiom" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Part of Speech" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.PartOfSpeech, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="Meaning" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Ko, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <TextBlock Text="Usage" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Expression, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
