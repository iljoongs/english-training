<Window x:Class="EnglishTraining.Views.TodayEnglishWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Today's English" Height="600" Width="500"
        Icon="pack://application:,,,/Assets/english-training.png">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="Save" Click="OnSaveClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusText" Foreground="#666666" FontSize="11" />
        </Border>

        <TextBox x:Name="ContentTextBox"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 Padding="8"
                 BorderThickness="0" />
    </DockPanel>
</Window>
