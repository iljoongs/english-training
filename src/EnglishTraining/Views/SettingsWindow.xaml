<Window x:Class="EnglishTraining.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="230" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Data folder" FontWeight="Bold" Margin="0,0,0,6" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="DataFolderTextBox" Grid.Column="0" Margin="0,0,6,0" VerticalContentAlignment="Center" />
            <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse…" Click="OnBrowseClick" Padding="14,6" MinWidth="90" />
        </Grid>

        <Button Grid.Row="2" x:Name="DefaultFolderButton" Content="Default folder"
                HorizontalAlignment="Right" Margin="0,8,0,0" Padding="14,6" MinWidth="110"
                Click="OnDefaultFolderClick" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" IsDefault="True" Width="90" Height="30" Margin="0,0,8,0" Click="OnOkClick" />
            <Button Content="Cancel" IsCancel="True" Width="90" Height="30" Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>
