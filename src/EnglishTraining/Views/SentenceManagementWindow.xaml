<Window x:Class="EnglishTraining.Views.SentenceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="문장 관리" Height="520" Width="840"
        Icon="pack://application:,,,/Assets/english-training.png">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일">
                <MenuItem Header="열기" Click="OnFileOpenClick" />
                <MenuItem Header="저장" Click="OnFileSaveClick" />
                <MenuItem Header="다른 이름으로 저장" Click="OnFileSaveAsClick" />
            </MenuItem>
            <MenuItem Header="문장">
                <MenuItem Header="신규" Click="OnAddNewClick" />
                <MenuItem Header="가져오기" Click="OnAddFromFileClick" />
                <MenuItem Header="내보내기" Click="OnExportClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="신규 추가" Padding="8,4" Margin="0,0,8,0" Click="OnAddNewClick" />
                <Button Content="파일 추가" Padding="8,4" Margin="0,0,8,0" Click="OnAddFromFileClick" />
                <Button Content="삭제" Padding="8,4" Click="OnDeleteClick" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding FileStatusText}" Foreground="#666666" FontSize="11" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TopicsListBox"
                     Grid.Column="0"
                     ItemsSource="{Binding Topics}"
                     DisplayMemberPath="Title"
                     SelectionMode="Extended"
                     SelectedItem="{Binding SelectedTopic}"
                     MouseDoubleClick="OnTopicDoubleClick" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <DockPanel Grid.Column="2" Margin="12">
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedTopic.Title}" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                <TextBox Text="{Binding SelectedTopic.Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
