<Window x:Class="EnglishTraining.Views.ReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="영어 학습" Height="520" Width="840"
        Icon="pack://application:,,,/Assets/english-training.png">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="관리">
                <MenuItem Header="문장 관리" Click="OnManageTopicsClick" />
                <MenuItem Header="해석 관리" Click="OnManageInterpretationsClick" />
                <MenuItem Header="영작 관리" Click="OnManageWritingsClick" />
                <MenuItem Header="표현 관리" Click="OnManageExpressionsClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="A-" Width="32" Margin="0,0,4,0" Command="{Binding DecreaseFontSizeCommand}" />
                <Button Content="A+" Width="32" Margin="0,0,20,0" Command="{Binding IncreaseFontSizeCommand}" />

                <CheckBox Content="해석" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding ShowInterpretation}" />
                <CheckBox Content="영작" VerticalAlignment="Center" Margin="0,0,12,0" IsChecked="{Binding ShowWriting}" />
                <CheckBox Content="표현" VerticalAlignment="Center" IsChecked="{Binding ShowExpression}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TopicsListBox"
                     Grid.Column="0"
                     DisplayMemberPath="Title"
                     SelectionChanged="OnTopicSelectionChanged" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <FlowDocumentScrollViewer Grid.Column="2" Padding="16">
                <FlowDocument x:Name="Document" />
            </FlowDocumentScrollViewer>
        </Grid>
    </DockPanel>
</Window>
