<Window x:Class="EnglishTraining.Views.ReadingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="English Training" Height="520" Width="840"
        Icon="pack://application:,,,/Assets/english-training.png"
        KeyDown="OnWindowKeyDown">
    <DockPanel>
        <ToolBar DockPanel.Dock="Top">
            <Menu Background="Transparent" VerticalAlignment="Center">
                <MenuItem Header="&#9776;" FontSize="14" Padding="6,0">
                    <MenuItem Header="Reload" InputGestureText="F5" Click="OnReloadClick" />
                    <MenuItem Header="Study">
                        <MenuItem Header="Today's English" Click="OnTodayEnglishClick" />
                    </MenuItem>
                    <MenuItem Header="Settings…" Click="OnSettingsClick" />
                </MenuItem>
            </Menu>

            <Separator />
            <CheckBox Content="Word" VerticalAlignment="Center" IsChecked="{Binding ShowInterpretation}" />
            <CheckBox Content="Writing" VerticalAlignment="Center" IsChecked="{Binding ShowWriting}" />

            <Separator />
            <TextBlock Text="Font" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="140" ItemsSource="{Binding AvailableFontFamilyNames}" SelectedItem="{Binding FontFamilyName}" />

            <Separator />
            <TextBlock Text="Line Spacing" VerticalAlignment="Center" Margin="4,0" />
            <Slider Width="80" Minimum="1.0" Maximum="2.0" Value="{Binding LineSpacingMultiplier}" VerticalAlignment="Center" />

            <Separator />
            <TextBlock Text="Margin" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="80" ItemsSource="{Binding MarginPresetOptions}" SelectedItem="{Binding MarginPreset}" />

            <Separator />
            <TextBlock Text="Theme" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox Width="80" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding Theme}" />

            <Separator />
            <TextBlock Text="Brightness" VerticalAlignment="Center" Margin="4,0" />
            <Slider Width="80" Minimum="0" Maximum="0.7" Value="{Binding DimmingOpacity}" VerticalAlignment="Center" />
        </ToolBar>

        <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" BorderBrush="#DDDDDD" Padding="6,3">
            <TextBlock x:Name="StatusTextBlock" FontSize="11" Foreground="#666666" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="TopicsListBox"
                     Grid.Column="0"
                     DisplayMemberPath="Title"
                     SelectionChanged="OnTopicSelectionChanged" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <Grid Grid.Column="2">
                <FlowDocumentPageViewer x:Name="DocumentViewer"
                             BorderThickness="0"
                             ContextMenuOpening="OnDocumentContextMenuOpening">
                    <FlowDocumentPageViewer.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="Copy" />
                            <MenuItem Header="Add Word" Click="OnRegisterWordClick" />
                            <MenuItem Header="Add Sentence" Click="OnRegisterSentenceClick" />
                        </ContextMenu>
                    </FlowDocumentPageViewer.ContextMenu>
                    <FlowDocument x:Name="Document" />
                </FlowDocumentPageViewer>

                <TextBlock x:Name="GuidanceTextBlock"
                           Text="Data folder not found. Set it in Menu &gt; Settings."
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" Foreground="#888888"
                           Visibility="Collapsed" />

                <Rectangle Fill="Black" IsHitTestVisible="False" Opacity="{Binding DimmingOpacity}" />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
