<Window x:Class="EnglishTraining.Views.ExpressionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="표현 관리" Height="520" Width="840"
        Icon="pack://application:,,,/Assets/english-training.png">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="파일">
                <MenuItem Header="열기" Click="OnFileOpenClick" />
                <MenuItem Header="저장" Click="OnFileSaveClick" />
                <MenuItem Header="다른 이름으로 저장" Click="OnFileSaveAsClick" />
            </MenuItem>
            <MenuItem Header="표현">
                <MenuItem Header="신규" Click="OnAddNewClick" />
                <MenuItem Header="가져오기" Click="OnImportClick" />
                <MenuItem Header="내보내기" Click="OnExportClick" />
                <MenuItem Header="삭제" Click="OnDeleteClick" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top" Padding="12,8" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <Button Content="신규" Padding="8,4" Margin="0,0,8,0" Click="OnAddNewClick" />
                <Button Content="가져오기" Padding="8,4" Margin="0,0,8,0" Click="OnImportClick" />
                <Button Content="삭제" Padding="8,4" Click="OnDeleteClick" />
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Padding="8,4" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding FileStatusText}" Foreground="#666666" FontSize="11" />
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="EntriesListBox"
                     Grid.Column="0"
                     ItemsSource="{Binding Entries}"
                     DisplayMemberPath="Text"
                     SelectionMode="Extended"
                     SelectedItem="{Binding SelectedEntry}" />

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#DDDDDD" />

            <StackPanel Grid.Column="2" Margin="12">
                <TextBlock Text="표현" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="의미" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Meaning, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                <TextBlock Text="사용법" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Usage, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                <TextBlock Text="예문" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox Text="{Binding SelectedEntry.Example, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
