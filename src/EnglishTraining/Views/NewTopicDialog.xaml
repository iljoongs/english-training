<Window x:Class="EnglishTraining.Views.NewTopicDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 주제 추가" Height="160" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="LabelTextBlock" Text="주제명" Margin="0,0,0,4" />
        <TextBox x:Name="TitleTextBox" Margin="0,0,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="확인" Width="72" Margin="0,0,8,0" IsDefault="True" Click="OnOkClick" />
            <Button Content="취소" Width="72" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
